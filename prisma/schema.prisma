generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanId {
  trial
  starter
  pro
  enterprise
}

/// Stato di un invito nel Programma Referral B2B — riguarda solo lo sconto
/// dell'invitante (ricorrente per sempre), non quello dell'invitata (una
/// tantum, tracciato a parte da `Referral.refereeWelcomeDiscountAppliedAt`).
/// PENDING: l'invitata si è registrata col codice, non ancora a pagamento.
/// ACTIVE: l'invitata ha un abbonamento a pagamento attivo — l'invitante ha
/// lo sconto fisso del programma sul proprio abbonamento.
/// EXPIRED: l'invitata non è più a pagamento (disdetta, mancato rinnovo): lo
/// sconto dell'invitante si spegne (salvo che abbia altri referral ACTIVE),
/// ma il referral resta in storico.
enum ReferralStatus {
  PENDING
  ACTIVE
  EXPIRED
}

/// Motivo scelto dall'agenzia nel questionario di disdetta (flusso di
/// cancellazione, Modulo 2). "Altro" copre i casi non previsti, con il
/// dettaglio libero nel campo `details` di CancellationFeedback.
enum CancellationReason {
  TOO_EXPENSIVE
  NOT_USED_ENOUGH
  MISSING_FEATURES
  CHOSE_ALTERNATIVE
  OTHER
}

/// Stato del funnel di qualificazione di un lead.
/// OPT_OUT è distinto da UNQUALIFIED: indica una revoca esplicita del consenso
/// (STOP/CANCELLAMI) e blocca in modo permanente ogni invio successivo.
/// Chi ha spento l'assistente su una conversazione.
///
/// Serve perche' `aiEnabled = false` da solo non distingue due situazioni
/// opposte. Se l'ha spento **l'agente**, sta rispondendo lui e l'assistente
/// deve tacere qualunque cosa arrivi: riaccendersi significherebbe parlare
/// sopra una persona davanti al suo cliente.
///
/// Se l'ha spento **il filtro** dopo due messaggi fuori tema, e' una
/// precauzione automatica presa su chi sembrava aver sbagliato numero. Quella
/// precauzione non deve sopravvivere a una richiesta immobiliare vera: finora
/// lo faceva, e chi tornava a chiedere di una casa restava senza risposta per
/// sempre senza che nessuno se ne accorgesse.
enum AiPauseOrigin {
  /// `!pausa`, o l'interruttore nella scheda lead.
  AGENTE
  /// Sospensione automatica per messaggi fuori contesto ripetuti.
  FILTRO
}

enum QualificationStatus {
  PENDING
  IN_PROGRESS
  QUALIFIED
  UNQUALIFIED
  OPT_OUT
}

enum PortalSource {
  IMMOBILIARE_IT
  IDEALISTA
  CASA_IT
  SITO_WEB
  /// Contatto nato da una scansione del QR dell'agenzia (vetrina, cartello
  /// immobile, volantino). Tenerlo distinto da SITO_WEB è l'unico modo per
  /// dire all'agente se quel cartello sta davvero portando notizie.
  QR_CODE
  /// Caricato dall'agenzia da un file CSV: non è una notizia nuova ma un
  /// contatto già in rubrica, e mescolarlo alle altre falserebbe le statistiche.
  IMPORT
}

/// Classificazione commerciale del contatto in base al portafoglio immobili
/// rilevato. Serve all'agente per capire a colpo d'occhio se dal lead può
/// nascere anche un incarico di vendita, non solo una visita.
///
/// È sempre derivata da `Lead.ownedPropertiesCount` tramite
/// `deriveSellerCategory()` in lib/whatsapp/portfolio.ts: non va mai impostata
/// a mano, altrimenti conteggio e categoria possono divergere.
/// Cosa vuole fare il contatto: comprare, vendere, o entrambe le cose.
///
/// # Perche' non basta `SellerCategory`
///
/// Sono due assi diversi e vanno tenuti separati. `SellerCategory` dice
/// **quanti immobili possiede** — informazione commerciale, ricavata dal
/// conteggio del portafoglio. `LeadIntent` dice **cosa e' venuto a chiedere**:
/// un proprietario di tre case puo' scrivere per comprarne una quarta, e un
/// nullatenente puo' scrivere per vendere la casa che ha ereditato.
///
/// Serve a decidere le domande. A chi vuole vendere non si chiede il budget
/// d'acquisto ne' la zona in cui cerca: si chiede dove sta l'immobile che ha,
/// com'e' fatto e quando vuole venderlo. Sbagliare ramo qui significa fare a
/// una persona quattro domande che non la riguardano.
enum LeadIntent {
  ACQUISTO
  VENDITA
  /// Vuole vendere per comprare: entrambi i percorsi valgono, ed e' il caso
  /// commercialmente piu' interessante — due operazioni con lo stesso
  /// contatto.
  ENTRAMBI
}

enum SellerCategory {
  BUYER_ONLY
  SINGLE_SELLER
  MULTI_OWNER
}

/// Tipo di documento nel fascicolo di un immobile o di un cliente.
///
/// L'elenco segue i documenti che un'agenzia immobiliare italiana raccoglie
/// davvero durante un incarico, non una tassonomia generica: è ciò che rende
/// utile la lista "cosa manca" invece di un archivio indistinto.
enum DocumentCategory {
  IDENTITA
  CODICE_FISCALE
  VISURA_CATASTALE
  PLANIMETRIA
  ATTO_PROVENIENZA
  APE
  MANDATO
  PROPOSTA
  COMPROMESSO
  CONFORMITA_IMPIANTI
  ALTRO
}

/// Tipo di elaborazione svolta dall'AI, per filtrare la cronologia.
enum GenerationKind {
  /// Modulo 2 — estrazione da visura, atto o planimetria.
  DOCUMENT_EXTRACTION
  /// Modulo 3 — annuncio per i portali.
  LISTING
  /// Modulo 3 — post social e script per i reel.
  SOCIAL
}

/// Ruolo di una persona dentro l'agenzia.
///
/// `OWNER` è il titolare: gestisce abbonamento, integrazioni e collaboratori.
/// `AGENT` è il collaboratore: lavora lead, agenda e immobili ma non tocca la
/// configurazione dell'agenzia né invita altre persone.
enum UserRole {
  OWNER
  AGENT
}

/// Fase della trattativa, gestita a mano dall'agente sulla board Kanban.
///
/// Volutamente separata da `QualificationStatus`: quest'ultimo è scritto
/// dall'agente AI a ogni messaggio del cliente e, se le due cose vivessero
/// nello stesso campo, la conversazione riporterebbe indietro una scheda che
/// l'agente ha appena spostato su "Proposta inviata".
enum DealStage {
  NEW
  QUALIFIED
  VISIT_SCHEDULED
  OFFER_SENT
  WON
  LOST
}

enum ContractType {
  VENDITA
  AFFITTO
}

enum PropertyType {
  APPARTAMENTO
  ATTICO
  VILLA
  VILLETTA
  LOFT
  RUSTICO
  TERRENO
  NEGOZIO
  UFFICIO
  BOX
  ALTRO
}

/// Classi energetiche italiane, dalla migliore alla peggiore.
/// `A4`-`A1` sostituiscono la vecchia `A` dal 2015: entrambe compaiono negli
/// APE in circolazione, quindi l'elenco le comprende tutte.
enum EnergyClass {
  A4
  A3
  A2
  A1
  A
  B
  C
  D
  E
  F
  G
}

/// Esito della validazione di una corrispondenza visura ↔ lead.
///
/// PENDING è lo stato iniziale di ogni match: il sistema propone, l'agente
/// decide. IGNORED registra un'omonimia accertata e impedisce che lo stesso
/// abbinamento venga riproposto al prossimo caricamento della stessa visura.
/// Stato commerciale dell'immobile.
///
/// Governa la visibilita' sui portali: il feed XML esporta SOLO `ACTIVE`.
/// `DRAFT` e' la scheda non ancora pronta, `RESERVED` il compromesso in corso,
/// `SOLD` il venduto, `ARCHIVED` il mandato chiuso o scaduto.
/// Tipo di incarico ricevuto dal proprietario.
///
/// Determina cosa l'agenzia puo' fare e quanto e' esposta: con un incarico in
/// esclusiva e' l'unica a trattare, con uno non esclusivo compete con altre, e
/// con una "selezione" ha solo il diritto di presentare acquirenti.
enum ListingType {
  ESCLUSIVA
  NON_ESCLUSIVA
  SELEZIONE
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  ARCHIVED
}

enum PortfolioMatchStatus {
  PENDING
  CONFIRMED
  IGNORED
}

/// Persona che accede alla piattaforma per conto di un'agenzia.
///
/// L'autenticazione vive qui, non più su `Organization`: un'agenzia con cinque
/// agenti aveva cinque persone su una sola password, e il piano Professional
/// prometteva l'opposto. Ogni utente appartiene a una sola organizzazione, che
/// resta il confine del multi-tenancy.
model User {
  id String @id @default(cuid())

  email        String  @unique
  /// Null per gli account creati via Google e per gli inviti non ancora
  /// accettati: il provider Credentials rifiuta chi non ha un hash.
  passwordHash String?
  firstName    String?
  lastName     String?

  role UserRole @default(AGENT)

  /// --- Invito di un collaboratore ---
  ///
  /// Del token si conserva solo l'hash: chi legge il database non deve poter
  /// ricostruire un link di invito valido e accedere all'agenzia.
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?
  /// `null` finché la persona non ha impostato la propria password.
  acceptedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedLeads       Lead[]
  knownDevices        KnownDevice[]
  passwordResets      PasswordResetToken[]
  assignedSlots       CalendarSlot[]
  uploadedDocuments   AgencyDocument[]
  aiGenerations       AiGeneration[]
  calendarConnections CalendarConnection[]

  @@index([organizationId, role])
  leadNotes      LeadNote[]
}

/// Ogni Agenzia immobiliare è un tenant isolato.
///
/// Non è più l'account di login: le credenziali sono passate a `User`. I campi
/// `email` e `passwordHash` restano per compatibilità con i dati esistenti e
/// non vengono più letti dall'autenticazione.
model Organization {
  id String @id @default(cuid())

  email        String  @unique
  /// Null per gli account creati via OAuth (Google): non hanno una password
  /// locale. Il provider Credentials rifiuta gli account senza hash.
  passwordHash String?

  /// Nome e cognome della persona che ha aperto l'account, distinti dal nome
  /// dell'agenzia: "Mario Rossi" è il referente, "Rossi Immobiliare" è
  /// l'organizzazione, e servono in due posti diversi.
  ///
  /// Opzionali a livello di schema perché gli account creati via OAuth non
  /// passano dal form di registrazione: lì i due campi si ricavano, quando
  /// possibile, dal profilo Google. Il form li richiede entrambi.
  firstName String?
  lastName  String?

  agencyName          String
  /// false quando `agencyName` è stato dedotto (es. dal nome dell'account
  /// Google) anziché dichiarato dall'agenzia. Un flag esplicito è più
  /// affidabile del confrontare a posteriori il nome con quello del profilo.
  agencyNameConfirmed Boolean @default(false)

  /// Ragione sociale completa, usata nell'intestazione dei PDF consegnati a
  /// proprietari e clienti. Distinta da `agencyName`, che è il nome d'uso.
  legalName String?

  /// --- Scheda agenzia: cio' che l'assistente puo' dire al cliente ---
  ///
  /// Campi liberi e non strutturati di proposito. Un'agenzia con due sedi e
  /// l'apertura del sabato a settimane alterne non entra in uno schema, e uno
  /// schema che non la contiene la costringe a scrivere qualcosa di falso.
  /// Il testo finisce nel prompt cosi' com'e', dove serve solo che sia
  /// leggibile.
  ///
  /// Tutti facoltativi: l'assistente dice "le faccio richiamare da un agente"
  /// per cio' che non sa, che e' sempre meglio di un orario inventato.
  address        String?
  publicPhone    String?
  /// Orari di apertura dell'ufficio, es. "Lun-Ven 9-13 e 15-19, Sab 9-12".
  officeHours    String?
  /// Fasce in cui l'agenzia fa visitare gli immobili, se diverse dall'ufficio.
  visitHours     String?
  /// Note libere: domande ricorrenti, zone servite, servizi offerti.
  /// E' la "FAQ" dell'agenzia, in prosa.
  knowledgeNotes String?
  /// Logo dell'agenzia come data URI (immagine piccola, in linea).
  /// Salvato nel database anziché su filesystem perché il deploy è serverless
  /// e non ha storage persistente; la dimensione è limitata a monte.
  logoDataUrl    String?

  /// Accettazione dell'accordo sul trattamento dei dati (DPA).
  ///
  /// Si registrano istante e versione, non un semplice booleano: revisionando
  /// il testo, senza la versione non sarebbe più dimostrabile *quale* accordo
  /// una data agenzia abbia accettato — che è precisamente ciò che va provato
  /// in caso di contestazione o audit.
  dpaAcceptedAt      DateTime?
  dpaAcceptedVersion String?

  /// --- Programma Referral B2B ---
  ///
  /// Codice pubblico da condividere ("PROP-XXXXXX"), generato una sola volta
  /// alla creazione dell'agenzia (lib/referrals/code.ts) e mai più cambiato:
  /// un link di invito già condiviso da un'agenzia non deve smettere di
  /// funzionare.
  referralCode String @unique

  /// --- Integrazione con il gestionale / MLS dell'agenzia ---
  ///
  /// Endpoint a cui inoltrare il lead appena diventa QUALIFIED (Zapier, Make,
  /// Gestim o qualsiasi API esterna). `null` = integrazione non configurata.
  /// Postazioni ACQUISTATE oltre quelle incluse nel piano.
  ///
  /// # Perche' l'extra e non il totale
  ///
  /// Perche' il totale e' derivabile e l'extra no. `maxSeats` assoluto
  /// duplicherebbe le postazioni incluse nel piano, che vivono in
  /// `lib/plans.ts`: al primo cambio di listino le due fonti divergono, e
  /// un'agenzia si ritrova un limite che non corrisponde a quello che paga.
  ///
  /// Il totale si ottiene con `maxSeatsFor()` — postazioni del piano piu'
  /// queste. Stessa scelta di `sellerCategory`, che si deriva sempre e si
  /// persiste solo per poterla interrogare.
  ///
  /// Sincronizzato dal webhook Stripe con la quantita' della voce "postazione
  /// aggiuntiva" sull'abbonamento: la fonte di verita' su quanto l'agenzia
  /// paga resta Stripe, questo campo e' la copia locale per non interrogarlo
  /// a ogni caricamento di pagina.
  extraSeats Int @default(0)

  socialConnection SocialConnection?

  crmWebhookUrl    String?
  /// Segreto con cui si firma il payload (HMAC-SHA256, header
  /// `X-PropertyTech-Signature`). Generato dal sistema, non scelto dall'utente:
  /// permette al gestionale di verificare che la chiamata arrivi davvero da noi
  /// e non da chiunque conosca l'URL.
  crmWebhookSecret String?

  /// Endpoint REST da cui importare gli annunci del gestionale (direzione
  /// opposta a `crmWebhookUrl`: da lì il gestionale RICEVE i lead, da qui
  /// PropertyTech LEGGE gli immobili). Riusa `crmProvider`/`crmAuthToken` per
  /// l'autenticazione: nella maggior parte dei gestionali la stessa chiave
  /// vale per lettura e scrittura, cambia solo l'indirizzo. `null` =
  /// importazione non configurata.
  crmListingImportUrl  String?
  /// Ultima sincronizzazione riuscita, mostrata in UI così l'agenzia sa se
  /// il portafoglio è aggiornato senza dover guardare i log.
  crmListingImportedAt DateTime?
  /// Tracciato personalizzato per l'import: nome del campo nel gestionale →
  /// nostro campo (direzione opposta a `crmFieldMap`). `null` = si assume che
  /// il gestionale risponda già con i nostri nomi di campo nativi.
  crmListingFieldMap   Json?

  /// Quale gestionale è collegato: `webhook`, `zapier`, `make`, `getrix`…
  ///
  /// Stringa e non enum Prisma di proposito: l'elenco vive in
  /// `lib/integrations/providers.ts`, che è già la fonte di verità di schema di
  /// autenticazione e mappatura campi. Con un enum, aggiungere un gestionale
  /// richiederebbe una migrazione del database per un dato che è solo
  /// un'etichetta. I valori ignoti ripiegano sul webhook generico.
  crmProvider String?

  /// Credenziale del gestionale (token Bearer o chiave API), **cifrata**
  /// con AES-256-GCM da `lib/crypto/secrets.ts`. In chiaro sarebbe leggibile
  /// da qualunque copia del database e permetterebbe di scrivere nel
  /// gestionale dell'agenzia. Non torna mai al browser: la UI ne mostra solo
  /// le ultime quattro cifre.
  crmAuthToken String?
  /// Nome utente per l'autenticazione Basic. Non è un segreto e resta in chiaro.
  crmAuthUser  String?

  /// Mappatura campo nostro → nome del campo nel gestionale.
  /// `null` = si usa quella del preset. Le chiavi ignote sono scartate in
  /// lettura, così una mappatura manomessa non può iniettare campi arbitrari
  /// nel corpo che spediamo.
  crmFieldMap Json?

  /// Token del feed XML che i portali (Immobiliare.it, Idealista, Casa.it)
  /// interrogano periodicamente per prelevare il portafoglio.
  ///
  /// Serve un segreto nell'URL perche' un crawler di portale non ha una
  /// sessione: l'unica alternativa sarebbe un feed pubblico a indirizzo
  /// indovinabile, cioe' il portafoglio di ogni agenzia leggibile da chiunque.
  ///
  /// `null` = feed mai attivato. Non si genera d'ufficio alla registrazione:
  /// un URL che espone dati senza che nessuno l'abbia chiesto e' esattamente
  /// il tipo di superficie che non deve esistere per gli account che non la
  /// useranno mai.
  ///
  /// `@unique` non e' solo un vincolo: e' l'indice su cui la rotta pubblica
  /// risolve l'agenzia a ogni chiamata del portale.
  listingFeedToken String? @unique

  createdAt DateTime @default(now())

  users                User[]
  subscription         Subscription?
  usageTracker         UsageTracker?
  whatsAppConfig       WhatsAppConfig?
  leads                Lead[]
  calendarSlots        CalendarSlot[]
  calendarConnections  CalendarConnection[]
  voiceReports         VoiceReport[]
  portfolioMatches     PortfolioMatch[]
  properties           Property[]
  propertyImages       PropertyImage[]
  propertyMatches      PropertyLeadMatch[]
  agencyDocuments      AgencyDocument[]
  aiGenerations        AiGeneration[]
  cancellationFeedback CancellationFeedback[]
  /// Referral in cui questa agenzia è l'invitante (può essere molti).
  referralsSent        Referral[]             @relation("ReferralsSent")
  /// Referral in cui questa agenzia è l'invitata (al massimo uno: non si può
  /// essere invitati due volte).
  referredBy           Referral?              @relation("ReferralsReceived")
  mutedContacts        WhatsAppMutedContact[]
  leadNotes            LeadNote[]
  radarProperties      RadarProperty[]
  auctionAppraisals    AuctionAppraisal[]
  auctionMatches       AuctionLeadMatch[]
  radarZoneDemand      RadarZoneDemand[]
}

/// Programma Referral B2B: un'agenzia (Referrer) invita un'altra (Referee) col
/// proprio `referralCode`. Una riga per invito, non per rimando: se
/// un'invitata disdice e si registra di nuovo, resta la stessa riga — non è
/// un nuovo referral, `refereeId` è unico.
model Referral {
  id String @id @default(cuid())

  status ReferralStatus @default(PENDING)

  /// Quando è diventato ACTIVE (primo pagamento dell'invitata) e quando è
  /// tornato EXPIRED (disdetta/mancato rinnovo), se mai avvenuto.
  activatedAt DateTime?
  expiredAt   DateTime?

  /// Quando è stato applicato lo sconto di benvenuto del 10% all'invitata, al
  /// checkout del suo primo abbonamento a pagamento. `null` finché non paga;
  /// una volta impostato resta tale per sempre — è una tantum, non revocato
  /// da un'eventuale disdetta successiva, e non riapplicato a un nuovo
  /// abbonamento (altrimenti disdire e riabbonarsi lo farebbe scattare di
  /// nuovo). Indipendente da `status`, che riguarda solo l'invitante.
  refereeWelcomeDiscountAppliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrerId String
  referrer   Organization @relation("ReferralsSent", fields: [referrerId], references: [id], onDelete: Cascade)

  refereeId String       @unique
  referee   Organization @relation("ReferralsReceived", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId, status])
}

model Subscription {
  id                   String  @id @default(cuid())
  status               PlanId  @default(trial)
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  /// Impostato quando l'agenzia conferma la disdetta (`cancel_at_period_end`
  /// su Stripe): l'abbonamento resta attivo fino a `currentPeriodEnd`, non
  /// finisce subito. Sincronizzato anche dal webhook, per restare corretto
  /// anche se la disdetta avviene dal portale clienti di Stripe.
  cancelAtPeriodEnd          Boolean   @default(false)
  /// Fine del periodo di fatturazione corrente, da Stripe. `null` finché non
  /// è mai arrivato un evento con questo dato.
  currentPeriodEnd           DateTime?
  /// Quando è stato applicato lo sconto di retention (-50% a vita). Non è la
  /// fonte di verità del prezzo — quella resta Stripe — ma serve a sapere se
  /// è già stato offerto a questa agenzia.
  retentionDiscountAppliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Risposta al questionario di disdetta: una riga per ogni cancellazione
/// confermata (un'agenzia può riabbonarsi e disdire più volte nel tempo). Il
/// piano è duplicato dallo stato dell'abbonamento al momento dell'evento
/// perché l'aggiornamento successivo del piano lo sovrascriverebbe.
model CancellationFeedback {
  id                 String             @id @default(cuid())
  reason             CancellationReason
  details            String?
  planAtCancellation PlanId
  createdAt          DateTime           @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Contatori di consumo crediti per periodo corrente. I limiti per piano
/// vivono in lib/plans.ts, non qui, per avere un'unica fonte di verità.
/// Dispositivo gia' visto per un utente, per l'avviso di accesso nuovo.
///
/// Si conserva un'IMPRONTA e non i dati grezzi: `fingerprint` e' un hash di
/// user agent e indirizzo IP troncato. L'indirizzo IP e' un dato personale
/// (cons. 30 GDPR) e conservarlo in chiaro significherebbe costruire uno
/// storico degli spostamenti di ogni agente, per una funzione che ha solo
/// bisogno di sapere "questo l'avevo gia' visto?".
///
/// `label` e' leggibile ("Chrome su Windows") perche' finisce nell'email: un
/// hash non direbbe nulla a chi deve decidere se l'accesso era suo.
/// Richiesta di reimpostazione password.
///
/// Tabella separata e non campi su `User` come per gli inviti: un utente puo'
/// chiedere il reset piu' volte - il primo messaggio finisce in spam, il
/// secondo arriva - e con campi singoli ogni richiesta invaliderebbe la
/// precedente, incluso il link che la persona sta per aprire.
///
/// Del token resta la sola impronta: chi legge il database non deve poter
/// ricostruire un link valido ed entrare in un account.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  /// Valorizzato all'uso: un token consumato non vale una seconda volta,
  /// nemmeno prima della scadenza.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model KnownDevice {
  id          String   @id @default(cuid())
  fingerprint String
  label       String
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId])
}

model UsageTracker {
  id                  String @id @default(cuid())
  whatsappCreditsUsed Int    @default(0)
  docCreditsUsed      Int    @default(0)
  voiceCreditsUsed    Int    @default(0)

  /// Soglia percentuale di consumo per cui e' gia' partito un avviso.
  ///
  /// Serve a non rispedire la stessa email a ogni messaggio successivo al
  /// superamento: si registra la soglia piu' alta gia' notificata e si invia
  /// solo quando se ne supera una nuova.
  ///
  /// Azzerate al rinnovo del periodo, insieme ai contatori: il mese nuovo
  /// ricomincia da capo anche per gli avvisi.
  whatsappNotifiedPct Int      @default(0)
  docNotifiedPct      Int      @default(0)
  voiceNotifiedPct    Int      @default(0)
  updatedAt           DateTime @updatedAt

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Credenziali Meta WhatsApp Cloud API per agenzia.
/// `inboundToken` è il segreto che i portali includono nel webhook di ingaggio
/// lead: identifica il tenant senza esporre l'organizationId.
model WhatsAppConfig {
  id                 String  @id @default(cuid())
  isConnected        Boolean @default(false)
  phoneNumber        String?
  metaAccessToken    String?
  metaPhoneAccountId String?
  webhookVerifyToken String?
  /// Identifica il tenant sulle rotte pubbliche che non passano da NextAuth
  /// (ingaggio lead dai portali, webhook WhatsApp generico): un token nell'URL
  /// o nell'header, non l'organizationId in chiaro.
  inboundToken       String  @unique @default(cuid())

  /// --- Provider di messaggistica ---
  /// Quale trasporto usa questa agenzia: `meta` (Cloud API diretta, storico
  /// e default), `twilio`, `generic` (relay verso un BSP non elencato).
  /// Stringa e non enum, stesso motivo di Organization.crmProvider: un
  /// provider in più è un dato, non deve costare una migrazione.
  provider String @default("meta")

  /// --- Twilio ---
  twilioAccountSid     String?
  /// Auth Token, cifrato con lo stesso schema del token Meta (lib/whatsapp/credentials.ts).
  twilioAuthToken      String?
  /// Mittente nel formato richiesto da Twilio, es. "whatsapp:+14155238886".
  twilioWhatsAppNumber String?

  /// --- Webhook generico (BSP non elencati) ---
  /// Endpoint a cui POSTiamo i messaggi in uscita quando `provider = "generic"`.
  genericSendUrl   String?
  /// Credenziale opzionale (Bearer), cifrata come sopra.
  genericAuthToken String?

  /// --- Collegamento via QR (provider = "qr") ---
  ///
  /// Nome della sessione sul microservizio esterno che tiene aperto il socket
  /// verso WhatsApp. Non contiene credenziali: le chiavi della sessione
  /// restano sul microservizio, qui c'è solo il riferimento con cui
  /// interrogarlo. Un'esposizione di questo campo non permette di inviare
  /// messaggi — serve comunque la chiave del servizio, che vive in ambiente.
  qrSessionId   String?   @unique
  /// Quando la sessione è stata abbinata: utile a spiegare all'agenzia da
  /// quanto regge il collegamento, che con un client non ufficiale può
  /// cadere e richiedere una nuova scansione.
  qrConnectedAt DateTime?

  /// --- Promemoria anti no-show ---
  /// Attivo per default: il no-show è il costo operativo che questa funzione
  /// esiste per ridurre, e un'agenzia che non lo vuole lo disattiva in un clic.
  reminderEnabled     Boolean @default(true)
  /// Quante ore prima dell'appuntamento parte il promemoria (tipicamente 2 o 24).
  reminderHoursBefore Int     @default(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Chiavi di ricerca di rotte pubbliche che NON possono filtrare per
  /// tenant: il tenant è proprio ciò che stanno cercando di stabilire.
  /// `webhookVerifyToken` serve all'handshake di Meta (raro);
  /// `twilioWhatsAppNumber` a ogni messaggio in arrivo da Twilio, che è un
  /// percorso caldo. Con una riga per agenzia la scansione sequenziale è
  /// ancora rapida, ma cresce col numero di clienti: l'indice la rende
  /// costante. Composto con `provider` perché è così che la rotta filtra.
  @@index([webhookVerifyToken])
  @@index([provider, twilioWhatsAppNumber])
}

/// Lead intercettato dai portali immobiliari e qualificato via WhatsApp.
/// `clientPhone` è unico per organizzazione: un secondo annuncio richiesto dallo
/// stesso numero riusa il lead esistente invece di duplicarlo.
model Lead {
  id          String @id @default(uuid())
  clientName  String
  clientPhone String

  /// Indirizzo WhatsApp esatto della conversazione (`<id>@s.whatsapp.net`
  /// oppure `<id>@lid`), come ricevuto dal provider.
  ///
  /// Esiste perche' WhatsApp non identifica piu' tutti i contatti col numero:
  /// per molte chat consegna un LID, un identificativo opaco che NON e' un
  /// recapito telefonico. Ricostruire l'indirizzo come `<cifre>@s.whatsapp.net`
  /// - che e' quello che facevamo - produce in quei casi un indirizzo
  /// inesistente: la libreria lo accetta, risponde che ha inviato, e il
  /// messaggio non arriva a nessuno. Rispondere all'indirizzo da cui il
  /// messaggio e' arrivato e' l'unica strada che vale in entrambi i casi.
  ///
  /// `null` per i lead nati da altri canali (portali, import CSV), dove il
  /// numero e' un numero vero e l'indirizzo si costruisce senza ambiguita'.
  waChatJid String?

  /// Risposta automatica dell'assistente su questa conversazione.
  ///
  /// `false` = presa in carico da una persona. L'AI non genera e non invia piu'
  /// nulla, ma i messaggi in arrivo continuano a essere registrati in
  /// cronologia: l'agente che subentra deve vedere cosa il cliente ha scritto
  /// mentre l'assistente taceva.
  ///
  /// Default `true` per non cambiare il comportamento delle conversazioni gia'
  /// aperte quando questo campo e' stato introdotto.
  aiEnabled Boolean @default(true)

  /// Perche' l'assistente e' spento, quando lo e'. `null` quando e' acceso.
  /// Vedi `AiPauseOrigin`: e' la differenza fra "tace perche' rispondi tu" e
  /// "tace perche' sembrava un numero sbagliato".
  aiPausedBy AiPauseOrigin?

  /// Messaggi consecutivi giudicati fuori contesto dal filtro di pertinenza.
  ///
  /// Azzerato da qualunque messaggio pertinente: conta la *serie*, non il
  /// totale. Una domanda strana in mezzo a una qualificazione non deve
  /// avvicinare il contatto alla sospensione.
  ///
  /// Raggiunta la soglia, `aiEnabled` passa a `false`: chi ha sbagliato numero
  /// o sta usando questo numero per altro non va inseguito da un assistente
  /// che risponde a ogni messaggio.
  offTopicStreak Int          @default(0)
  /// Email del contatto, quando l'agenzia ce l'ha in rubrica. Il flusso
  /// WhatsApp non la usa: serve all'agente e all'esportazione verso il gestionale.
  clientEmail    String?
  portalSource   PortalSource
  propertyRef    String

  /// Immobile del portafoglio a cui questa richiesta si riferisce.
  ///
  /// Facoltativo, e resta tale: un lead che scrive "cerco un trilocale in
  /// centro" non riguarda un immobile preciso, e forzarne uno sarebbe
  /// un'invenzione. `propertyRef` conserva sempre il testo originale.
  ///
  /// `SetNull` e non `Cascade`: cancellare un immobile dal portafoglio non
  /// deve portarsi via i contatti che ci avevano scritto: quelle persone
  /// esistono ancora e vanno ricontattate.
  propertyId          String?
  property            Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  qualificationStatus QualificationStatus @default(PENDING)

  budget           String?
  mortgageApproved Boolean?
  mustSellFirst    Boolean?
  timeframe        String?
  appointmentSlot  DateTime?

  /// --- Lead Intelligence: portafoglio immobili del contatto ---
  ///
  /// Numero di immobili che risultano in possesso del contatto. È una stima,
  /// non un dato certificato: nasce da ciò che il cliente dichiara durante la
  /// qualificazione, dall'incrocio con gli intestatari delle visure caricate
  /// nel Modulo 2, o dall'inserimento manuale dell'agente.
  ///
  /// `null` significa "non ancora rilevato" ed è diverso da `0`, che significa
  /// "acquirente senza immobili da vendere": la GUI mostra due cose diverse.
  /// Cosa e' venuto a chiedere. `null` finche' non e' chiaro.
  intent LeadIntent?

  /// --- Immobile che il contatto vuole vendere (acquisizione incarico) ---
  ///
  /// Popolati dal ramo venditore della qualificazione. Restano `null` per chi
  /// scrive solo per comprare, ed e' giusto cosi': un campo vuoto dice "non
  /// chiesto", uno riempito a caso direbbe il falso su un immobile vero.
  sellerPropertyComune       String?
  sellerPropertyZona         String?
  sellerPropertyType         PropertyType?
  sellerPropertySquareMeters Int?
  /// Stato dell'immobile come lo descrive il proprietario: "ristrutturato",
  /// "da ristrutturare", "buono stato". Testo libero e non un enum: e' quello
  /// che serve all'agente per decidere se vale un sopralluogo, e ogni
  /// tassonomia che si potrebbe imporre qui perderebbe la sfumatura.
  sellerPropertyCondition    String?
  sellerTimeframe            String?
  /// Ha detto di si' a un sopralluogo di valutazione. `null` = non ancora
  /// chiesto, che e' diverso da `false` = ha rifiutato.
  sellerValuationInterest    Boolean?

  ownedPropertiesCount Int?
  /// Derivata sempre da `ownedPropertiesCount`. È persistita, invece che
  /// calcolata a ogni lettura, solo per poter filtrare e ordinare i lead lato
  /// database senza scorrere le righe in memoria.
  sellerCategory       SellerCategory?
  /// --- Promemoria anti no-show sull'appuntamento ---
  ///
  /// Istante di invio del promemoria WhatsApp; `null` = non ancora inviato.
  /// Serve anche da guardia di idempotenza: il job può girare più volte
  /// nella stessa finestra senza tempestare il cliente di messaggi.
  reminderSentAt       DateTime?
  /// Risposta del cliente al promemoria: `true` = SI (confermato),
  /// `false` = NO (disdetta), `null` = non ha ancora risposto.
  appointmentConfirmed Boolean?

  /// --- Fase della trattativa (board Kanban) ---
  ///
  /// Distinta da `qualificationStatus`, che è dell'AI. L'agente la muove a
  /// mano; il valore iniziale si deriva dallo stato di qualifica una sola
  /// volta, alla creazione del lead.
  dealStage DealStage @default(NEW)

  /// --- Preferenze di ricerca dichiarate, per lo Smart Matching ---
  ///
  /// Tutte opzionali: si popolano man mano che emergono dalla conversazione o
  /// che l'agente le raccoglie al telefono. Un lead senza preferenze non
  /// partecipa al matching, invece di generare accoppiamenti casuali.
  ///
  /// `budgetMin`/`budgetMax` sono in euro interi, non testo: `Lead.budget`
  /// resta la frase così come l'ha detta il cliente ("intorno ai 250 mila"),
  /// che serve all'agente ma non è confrontabile.
  preferredZone   String?
  preferredType   PropertyType?
  budgetMin       Int?
  budgetMax       Int?
  minSquareMeters Int?

  /// Agente dell'agenzia che segue questo contatto. `null` = non ancora
  /// assegnato, ed è diverso da "assegnato al titolare": la pipeline mostra i
  /// due stati in modo distinto.
  assignedToId String?

  /// Ultima consegna riuscita al gestionale dell'agenzia via webhook.
  /// `null` significa "mai esportato", ed è ciò che la scheda lead mostra
  /// all'agente prima che l'integrazione sia configurata o vada a buon fine.
  crmDeliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo       User?               @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  chat             WhatsAppChat?
  portfolioMatches PortfolioMatch[]
  propertyMatches  PropertyLeadMatch[]
  documents        AgencyDocument[]

  /// Slot prenotato a valle della qualificazione. `appointmentSlot` resta come
  /// copia denormalizzata dell'orario, così lo storico dell'appuntamento
  /// sopravvive all'eventuale cancellazione dello slot in agenda.
  calendarSlotId String?       @unique
  calendarSlot   CalendarSlot? @relation(fields: [calendarSlotId], references: [id], onDelete: SetNull)

  @@unique([organizationId, clientPhone])
  @@index([organizationId, qualificationStatus])
  /// Lead di un immobile: usato dalla scheda immobile e dal bilancio al proprietario.
  @@index([propertyId])
  /// Supporta il caricamento per colonna della board Kanban.
  @@index([organizationId, dealStage])
  /// Filtro "i miei lead" nella pipeline.
  @@index([organizationId, assignedToId])
  /// Supporta l'ordinamento "prima i multi-proprietari" della pipeline lead.
  @@index([organizationId, ownedPropertiesCount])
  notes            LeadNote[]
  auctionMatches   AuctionLeadMatch[]
}

/// Corrispondenza proposta fra un intestatario di visura (Modulo 2) e un lead
/// in pipeline (Modulo 1), in attesa di validazione dell'agente.
///
/// Perché non si fondono i dati in automatico: "Mario Rossi" nella visura e
/// "Mario Rossi" fra i lead possono essere due persone diverse. Attribuire a un
/// contatto un immobile che non è suo significa trattare un dato personale
/// errato — e far chiamare all'agenzia un acquirente proponendogli di vendere
/// una casa altrui. Il sistema quindi propone, l'agente conferma.
model PortfolioMatch {
  id String @id @default(cuid())

  /// Chiave catastale dell'immobile: comune|foglio|particella|subalterno.
  propertyKey        String
  comune             String?
  foglio             String?
  particella         String?
  subalterno         String?
  categoriaCatastale String?
  /// Intestatario così come compare nella visura, non normalizzato: è il testo
  /// che l'agente legge per decidere se si tratta della stessa persona.
  ownerName          String
  quotaProprieta     String?

  status     PortfolioMatchStatus @default(PENDING)
  resolvedAt DateTime?
  createdAt  DateTime             @default(now())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Un immobile può essere proposto una sola volta per lead: ricaricare la
  /// stessa visura non riapre una decisione che l'agente ha già preso.
  @@unique([leadId, propertyKey])
  @@index([organizationId, status])
}

/// Immobile in portafoglio all'agenzia.
///
/// Nasce dal Modulo 3: l'agente compila i dati strutturati, l'AI genera i
/// testi, e da qui escono sia il feed XML per i portali sia il confronto con
/// le preferenze dei lead. È il pezzo che finora mancava: gli annunci venivano
/// generati e persi, quindi non c'era nulla su cui far girare un matching né
/// da cui esportare un tracciato con i campi obbligatori.
model Property {
  id String @id @default(cuid())

  /// Riferimento interno dell'agenzia, quello che compare negli annunci.
  reference String
  title     String
  contract  ContractType
  type      PropertyType

  comune    String
  provincia String?
  /// Quartiere o zona, il criterio con cui gli acquirenti cercano davvero.
  zona      String?
  indirizzo String?

  /// Prezzo in euro interi: i centesimi non esistono nel mercato immobiliare
  /// e un intero si confronta senza sorprese di virgola mobile.
  priceEur     Int
  squareMeters Int
  rooms        Int?
  bathrooms    Int?
  floor        String?
  energyClass  EnergyClass?

  /// Testo dell'annuncio generato dall'AI, riusato nel feed XML.
  description String?

  /// Stato commerciale. `DRAFT` di default.
  ///
  /// # Perche' e' cambiato da ACTIVE
  ///
  /// Perche' un immobile appena salvato non e' un immobile pronto. Arriva da
  /// una generazione, da un import o da un modulo compilato in fretta: puo'
  /// avere il prezzo sbagliato, nessuna fotografia, una descrizione ancora da
  /// rileggere. Con il default precedente finiva nel feed alla prima lettura
  /// del portale, cioe' online, prima che qualcuno lo avesse guardato.
  ///
  /// La pubblicazione diventa cosi' un gesto: si sceglie "In vendita" dal menu
  /// quando la scheda e' a posto. E' un passaggio in piu' per l'agente, ed e'
  /// voluto — ritirare un annuncio sbagliato dai portali costa molto piu' di
  /// un clic.
  ///
  /// Il cambio riguarda solo le righe NUOVE: quelle gia' a portafoglio
  /// mantengono lo stato che hanno, e nessun immobile pubblicato viene
  /// ritirato. Il feed continua a esportare `PUBLISHED_STATUSES` e non e'
  /// stato toccato.
  status PropertyStatus @default(DRAFT)

  /// Fotografie dell'annuncio, in ordine di pubblicazione: la prima e' la
  /// copertina.
  ///
  /// Contiene **URL**, non byte. Oggi sono percorsi verso la nostra rotta
  /// pubblica (`/api/properties/images/...`), perche' i portali scaricano le
  /// immagini e un data URI non e' scaricabile. Il giorno in cui arrivera' un
  /// object storage in UE, la stessa colonna conterra' i suoi URL e nient'
  /// altro cambiera': ne' lo schema, ne' il feed, ne' la UI.
  images String[]

  /// --- Incarico di mediazione ---
  ///
  /// Sono i dati che decidono se un immobile si puo' pubblicizzare e quanto
  /// rende. Tutti facoltativi: un'agenzia puo' caricare una scheda prima di
  /// aver formalizzato il mandato, e un campo obbligatorio la costringerebbe a
  /// inventare una data.
  listingType       ListingType?
  /// Scadenza dell'incarico. Superata, l'immobile esce dal feed verso i
  /// portali: pubblicizzare senza mandato valido non e' consentito.
  mandateExpiration DateTime?
  /// Provvigione concordata in punti percentuali (es. 3 = 3%). `Decimal`
  /// perche' le mezze percentuali sono la norma e un float le arrotonderebbe.
  commissionRate    Decimal?     @db.Decimal(5, 2)
  keysInOffice      Boolean      @default(false)
  /// Dove sono le chiavi: "cassetta 12", "dal portiere", "le ha il
  /// proprietario". Testo libero perche' ogni agenzia le tiene a modo suo.
  keysLocation      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  photos         PropertyImage[]
  leads          Lead[]
  leadMatches    PropertyLeadMatch[]
  documents      AgencyDocument[]
  aiGenerations  AiGeneration[]

  /// Il riferimento è unico per agenzia: due immobili con lo stesso codice
  /// renderebbero ambiguo il feed verso i portali.
  @@unique([organizationId, reference])
  @@index([organizationId, createdAt])
  /// Il feed dei portali filtra sempre agenzia + stato: senza questo indice
  /// ogni lettura del feed sarebbe una scansione del portafoglio.
  @@index([organizationId, status])
  /// Il feed verso i portali filtra agenzia, stato e scadenza dell'incarico
  /// nella stessa query: senza questo indice ogni sua lettura sarebbe una
  /// scansione del portafoglio.
  @@index([organizationId, status, mandateExpiration])
}

/// Accoppiamento fra un immobile in portafoglio e un lead le cui preferenze
/// combaciano ("Match Perfetto").
///
/// Tabella distinta da `PortfolioMatch`, che confronta *nomi di persona* fra
/// visura e lead per l'anti-omonimia. Sono due domande diverse — "questo
/// intestatario è il mio contatto?" contro "questa casa piacerebbe al mio
/// contatto?" — e tenerle separate evita che un giorno un punteggio di
/// compatibilità venga scambiato per una conferma di identità.
/// Byte di una fotografia dell'annuncio.
///
/// Sta in una tabella separata, e non in una colonna di `Property`, perche'
/// le foto sono l'unico dato voluminoso del portafoglio: tenerle nella riga
/// dell'immobile farebbe pagare il loro peso a **ogni** query che legge un
/// immobile — l'elenco, lo Smart Match, il feed — anche quando le immagini
/// non servono.
///
/// **Limite dichiarato**: i byte stanno in PostgreSQL, come gia' avviene per
/// il fascicolo documentale. Regge il portafoglio di un'agenzia che parte,
/// non un archivio a regime. La migrazione a un object storage in UE non
/// tocchera' `Property.images`, che contiene URL: cambieranno solo gli URL.
model PropertyImage {
  id String @id @default(cuid())

  /// Data URI completo, stesso formato di `AgencyDocument.fileDataUrl`.
  dataUrl  String
  mimeType String
  byteSize Int

  createdAt DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Presente anche se ricavabile da `property`: ogni tabella con dati di
  /// tenant filtra sul proprio `organizationId` (CLAUDE.md §5), senza
  /// dipendere da una join per l'isolamento.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([organizationId])
}

model PropertyLeadMatch {
  id String @id @default(cuid())

  /// Punteggio 0-100 calcolato da lib/matching/smart-match.ts.
  score   Int
  /// Motivazioni leggibili ("Budget compatibile", "Zona richiesta"): l'agente
  /// deve capire *perché* è un match prima di alzare il telefono.
  reasons String[] @default([])

  /// Segnato quando l'agente ha preso visione, per non riproporlo ogni volta.
  seenAt    DateTime?
  createdAt DateTime  @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Un solo match per coppia: ricalcolare aggiorna il punteggio invece di
  /// accumulare duplicati.
  @@unique([propertyId, leadId])
  @@index([organizationId, score])
}

/// Documento nel fascicolo di un immobile o di un cliente.
///
/// Risolve tre cose che oggi un'agenzia tiene su cartelle e memoria: sapere
/// quali documenti esistono per un incarico, quali scadono, e per quanto vanno
/// conservati. La conservazione decennale non è una scelta di prodotto: il
/// D.Lgs. 231/2007 la impone ai soggetti obbligati, e gli agenti immobiliari
/// lo sono.
///
/// NOTA SULLO STORAGE: il contenuto è salvato in linea come data URI, con un
/// tetto stretto, perché il deploy è serverless e non ha filesystem
/// persistente. È adeguato a documenti scansionati singoli, non a un archivio
/// di volume: prima di un uso intensivo va introdotto uno storage a oggetti in
/// UE e questo campo va sostituito da un riferimento esterno.
model AgencyDocument {
  id String @id @default(cuid())

  title    String
  category DocumentCategory
  notes    String?

  /// File in linea, opzionale: il fascicolo resta utile anche solo come
  /// registro di cosa esiste e dove, per chi tiene gli originali altrove.
  fileDataUrl String?
  fileName    String?
  /// Byte del file originale, per mostrarne la dimensione senza decodificare.
  fileSize    Int?

  /// Scadenza del documento: carta d'identità, APE, conformità impianti.
  /// `null` per i documenti che non scadono, come un atto di provenienza.
  expiresAt DateTime?

  /// Fino a quando va conservato. Precalcolato e non derivato a ogni lettura,
  /// così resta valido anche se un domani la durata di legge cambia: ciò che
  /// conta è il termine applicabile al momento dell'acquisizione.
  retentionUntil DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Il documento appartiene al fascicolo di un immobile, di un cliente, o di
  /// entrambi: un mandato riguarda l'immobile e il proprietario insieme.
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  /// Chi l'ha caricato. `SetNull`: un documento non sparisce perché la persona
  /// che l'ha inserito ha lasciato l'agenzia.
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId, expiresAt])
  @@index([organizationId, propertyId])
  @@index([organizationId, leadId])
}

/// Richiesta di contatto dalla landing pubblica.
///
/// Non appartiene a nessuna `Organization`: la scrive un visitatore anonimo che
/// un'agenzia non è ancora. È l'unica tabella del sistema senza
/// `organizationId`, e la sola rotta che vi scrive è pubblica — da qui i
/// controlli anti-abuso.
model ContactRequest {
  id String @id @default(cuid())

  firstName  String
  lastName   String
  email      String
  /// Facoltativo: chi scrive dal modulo pubblico puo' non voler lasciare un
  /// numero, e obbligarlo fa abbandonare il modulo a chi voleva solo una
  /// risposta via email. NULL significa "non fornito", diverso da stringa
  /// vuota, che sarebbe un numero vuoto.
  phone      String?
  agencyName String?
  message    String

  /// Impronta SHA-256 dell'indirizzo IP, non l'indirizzo.
  ///
  /// L'IP è un dato personale (GDPR, considerando 30): serve solo a limitare gli
  /// invii ripetuti, e per quello un'impronta basta. Conservarlo in chiaro
  /// significherebbe custodire la posizione approssimativa di chi scrive senza
  /// alcun bisogno.
  ipHash String?

  /// Segnata quando la richiesta è stata evasa, così non si ricontatta due volte.
  handledAt DateTime?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ipHash, createdAt])
  @@index([email, createdAt])
}

/// Elaborazione svolta dall'AI, conservata per la cronologia.
///
/// Prima di questa tabella un'estrazione da visura **consumava un credito e poi
/// spariva al primo aggiornamento della pagina**: il risultato viveva solo nello
/// stato del browser. Un'agenzia che aveva pagato per leggere venti visure non
/// aveva modo di rileggerne una.
///
/// I report vocali restano su `VoiceReport`, che ha campi e stato di invio
/// propri: la cronologia li unisce in lettura anziché duplicarne lo storage.
model AiGeneration {
  id String @id @default(cuid())

  kind GenerationKind

  /// Come compare in elenco: nome del file per una visura, riferimento
  /// dell'immobile per un annuncio.
  title String

  /// Prime righe del risultato, già pronte per l'elenco.
  ///
  /// Ridondante rispetto a `output`, e volutamente: elencare cinquanta
  /// elaborazioni senza caricare cinquanta JSON interi è la differenza fra una
  /// lista che si apre e una che si aspetta.
  preview String

  /// Risultato completo, nella forma prodotta dal modulo che l'ha generato.
  output Json

  /// Immobile a cui l'elaborazione si riferisce, quando l'agente lo ha indicato:
  /// è ciò che permette lo storico nella scheda dell'immobile.
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  /// Chi l'ha lanciata. `SetNull`: la cronologia dell'agenzia non si svuota
  /// perché un collaboratore se ne è andato.
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// Ordine di lettura della cronologia: per agenzia, per tipo, dal più recente.
  @@index([organizationId, kind, createdAt])
  @@index([organizationId, propertyId, createdAt])
}

/// Traccia di un messaggio inviato all'assistente clienti pubblico.
///
/// Conserva **solo l'impronta dell'IP e l'istante**: mai il testo della
/// domanda. Serve a limitare gli abusi su una rotta che spende token a ogni
/// chiamata ed è raggiungibile senza autenticazione — e chi scrive nel widget
/// può digitare dati personali che non abbiamo motivo di custodire.
///
/// Il conteggio sta nel database e non in memoria perché il deploy è
/// serverless: un contatore per istanza conterebbe solo una frazione degli
/// invii, quindi non sarebbe un limite.
model SupportChatHit {
  id String @id @default(cuid())

  /// SHA-256 con sale dell'indirizzo IP.
  ipHash String

  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
}

/// Cronologia della conversazione WhatsApp fra l'agente AI e il cliente.
/// `messages` è un array JSON di { sender, text, timestamp } (vedi lib/whatsapp/types.ts).
model WhatsAppChat {
  id        String   @id @default(cuid())
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

/// Slot di disponibilità di un agente per le visite immobiliari.
/// Il numero di agende attive per organizzazione è limitato dal piano
/// (vedi `agendasLimit` in lib/plans.ts).
model CalendarSlot {
  id String @id @default(cuid())

  /// Nome mostrato al cliente nel messaggio WhatsApp ("giovedì alle 15 con
  /// Mario"). Resta una stringa anche quando lo slot è assegnato a un utente:
  /// il testo già inviato non deve cambiare se quella persona lascia
  /// l'agenzia e il suo account viene rimosso.
  agentName String
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Collaboratore che effettua la visita. `null` per gli slot generici, che
  /// qualsiasi agente dell'agenzia può coprire.
  assignedToId String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo     User?        @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  lead           Lead?

  @@index([organizationId, isBooked, startTime])
  @@index([organizationId, assignedToId])
}

/// Calendario esterno (Google / Outlook) collegato da un agente via OAuth.
///
/// Legato all'**utente**, non solo all'agenzia: il calendario è quello
/// personale dell'agente, e due collaboratori della stessa agenzia collegano
/// due account distinti. `organizationId` resta comunque obbligatorio perché
/// ogni query filtra sul tenant (CLAUDE.md §5) — senza, un id di connessione
/// indovinato darebbe accesso al calendario di un'altra agenzia.
model CalendarConnection {
  id String @id @default(cuid())

  /// `google` oppure `outlook`. Stringa e non enum, stesso motivo di
  /// `Organization.crmProvider`: un provider in più è un dato, non deve
  /// costare una migrazione del database.
  provider String

  /// Account collegato, mostrato in chiaro nella scheda ("Connesso come
  /// mario@agenzia.it"). Non è un segreto: serve all'agente per riconoscere
  /// *quale* casella ha collegato, e ricavarlo dal token a ogni lettura
  /// richiederebbe una chiamata di rete per disegnare una riga di interfaccia.
  accountEmail String

  /// Token OAuth, entrambi cifrati con lo stesso schema di
  /// lib/crypto/secrets.ts usato per WhatsApp e per i gestionali. Il refresh
  /// token in chiaro varrebbe più dell'access token: non scade, e da solo
  /// permette di leggere e scrivere l'agenda dell'agente a tempo indeterminato.
  accessToken  String
  refreshToken String?
  /// Scadenza dell'access token: sotto questa soglia si rinnova prima di usarlo.
  expiresAt    DateTime?

  /// Calendario su cui leggere e scrivere. "primary" copre il caso normale.
  calendarId String @default("primary")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Un solo collegamento per agente e provider: ricollegare aggiorna i token
  /// della riga esistente invece di accumulare connessioni morte.
  @@unique([userId, provider])
  @@index([organizationId, provider])
}

/// Iscrizione alla newsletter dalla landing pubblica.
///
/// Non è legata a un'organizzazione: chi si iscrive è tipicamente un visitatore
/// non ancora registrato. L'email è normalizzata in minuscolo prima del
/// salvataggio, così `@unique` intercetta davvero i doppioni.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  /// Nome e cognome dichiarati dal visitatore, per personalizzare gli invii.
  /// Opzionale: un'iscrizione con la sola email è comunque valida.
  name      String?
  email     String   @unique
  /// Pagina o campagna di provenienza, utile per misurare le conversioni.
  source    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Report post-visita generato dalla nota vocale dell'agente (Modulo 4).
///
/// GDPR (CLAUDE.md §5): l'audio grezzo NON è mai persistito. Viene elaborato in
/// memoria per ricavarne la trascrizione e poi scartato; qui restano solo il
/// testo trascritto e il report strutturato.
model VoiceReport {
  id           String    @id @default(cuid())
  propertyRef  String
  sellerName   String?
  sellerPhone  String?
  transcript   String
  report       Json
  sourceType   String
  sentToSeller Boolean   @default(false)
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

/// Collegamento alla Pagina Facebook e al profilo Instagram dell'agenzia.
///
/// # Perche' una tabella e non campi su Organization
///
/// Perche' porta un token, e un token vuole una riga sua: si revoca, scade e
/// si riemette, e tenerlo accanto ai dati anagrafici dell'agenzia significa
/// toccare quella riga a ogni rinnovo. Una tabella separata si cancella
/// quando l'agenzia scollega, senza lasciare campi vuoti in giro.
///
/// Una sola per agenzia: la Pagina Facebook e il profilo Instagram collegato
/// arrivano insieme dallo stesso consenso Meta, e gestire piu' pagine per la
/// stessa agenzia e' un problema che nessuna agenzia ha finche' non ha almeno
/// due sedi con due pagine distinte.
model SocialConnection {
  id String @id @default(cuid())

  /// Pagina Facebook: id e nome, per poter dire A COSA si e' connessi.
  /// Mostrare "Connesso" senza dire a quale pagina non permette di accorgersi
  /// che si e' collegata quella sbagliata.
  facebookPageId   String
  facebookPageName String

  /// Profilo Instagram Business agganciato alla Pagina. Facoltativo: una
  /// Pagina puo' esistere senza un profilo Instagram collegato, e in quel caso
  /// si pubblica solo su Facebook invece di rifiutare tutto.
  instagramUserId   String?
  instagramUsername String?

  /// Token di pagina, cifrato AES-256-GCM (CLAUDE.md §5).
  ///
  /// Pubblica a nome dell'agenzia sulla sua pagina: in chiaro sarebbe
  /// leggibile da qualunque copia del database e permetterebbe a chiunque di
  /// scrivere sui suoi social. Un valore non cifrato viene rifiutato, non
  /// usato come ripiego.
  accessToken String

  /// Quando scade il token, se Meta lo dichiara. `null` per i token di pagina
  /// a lunga durata, che non hanno una scadenza fissa ma possono comunque
  /// essere revocati dall'utente.
  expiresAt DateTime?

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Numeri su cui l'assistente non deve intervenire, per questa agenzia.
///
/// Serve al caso che una scheda lead non copre: la chat personale, il
/// fornitore, il collega. Lì `!pausa` non aveva nulla su cui agire, perché il
/// comando spegne `Lead.aiEnabled` e un lead non esiste ancora — e non deve
/// esistere, perché creare una scheda per poterla zittire sporcherebbe la
/// pipeline con contatti che nessuno ha chiesto di qualificare.
///
/// Tabella minima di proposito: è un elenco di numeri, non una relazione. Ha
/// senso finché resta l'eccezione manuale accanto al filtro automatico.
model WhatsAppMutedContact {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Numero normalizzato, nella stessa forma usata da `Lead.clientPhone`.
  clientPhone String

  /// Chi o cosa lo ha silenziato: comando dell'agente, o filtro automatico.
  reason String @default("comando_agente")

  createdAt DateTime @default(now())

  @@unique([organizationId, clientPhone])
  @@index([organizationId])
}

/// Nota interna di un agente su un lead.
///
/// # Perché una tabella e non un campo di testo sul lead
///
/// Una nota ha un autore e un momento. Con un campo unico due agenti che
/// scrivono nello stesso minuto si sovrascrivono a vicenda, e fra un mese
/// nessuno sa chi abbia scritto "richiamare dopo il 15" né quando: è proprio
/// l'informazione che serve a chi subentra su una trattativa.
///
/// # Perché l'autore sopravvive alla persona
///
/// `onDelete: SetNull` sull'autore: quando un collaboratore lascia l'agenzia
/// le sue note restano, con l'autore vuoto. Cancellarle porterebbe via la
/// storia della trattativa proprio nel momento in cui qualcun altro deve
/// prenderla in mano — che è il caso peggiore possibile.
///
/// Sul lead invece è `Cascade`: cancellata la scheda, le sue note non hanno
/// più un soggetto di cui parlare.
model LeadNote {
  id String @id @default(cuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// `null` quando l'autore non fa più parte dell'agenzia.
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  /// Nome dell'autore al momento della scrittura.
  ///
  /// Ridondante rispetto alla relazione, e voluto: è l'unico modo di mostrare
  /// "scritta da Marco" dopo che Marco è stato rimosso. Una nota firmata da
  /// nessuno vale molto meno di una nota firmata da chi non lavora più qui.
  authorName String?

  content String

  /// Il tenant è ripetuto qui e non solo dedotto dal lead: ogni query filtra
  /// sull'agenzia senza dover passare da una join (CLAUDE.md §5).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([organizationId])
}

// ─────────────────────────── Radar Immobili & Aste ───────────────────────────
//
// Modulo isolato dal resto: tabelle proprie, rotte proprie sotto /api/radar.
// L'unico punto di contatto con il nucleo esistente è `AuctionLeadMatch`, che
// riusa `Lead` in sola lettura per gli abbinamenti.

/// Da dove arriva l'opportunità. Oggi solo `MANUALE`: le altre voci esistono
/// perché il campo non cambi il giorno in cui si aggiunge una fonte, non
/// perché siano già implementate.
enum RadarSource {
  MANUALE
  PVP
  ASTALEGALE
  PORTALE
}

enum RadarKind {
  /// Asta giudiziaria.
  ASTA
  /// Ribasso di prezzo su un immobile di mercato.
  RIBASSO
}

/// Semaforo di rischio.
///
/// **Non è un giudizio del modello**: è il risultato di `lib/radar/risk.ts`
/// applicato ai fatti estratti. Il modello dice cosa c'è scritto nella
/// perizia, le regole dicono che colore ne consegue — e le regole sono
/// mostrate accanto al colore, così l'agente vede *perché*.
enum RiskLevel {
  VERDE
  GIALLO
  ROSSO
}

enum OccupancyStatus {
  LIBERO
  OCCUPATO_CON_TITOLO
  OCCUPATO_SENZA_TITOLO
  NON_DETERMINATO
}

/// Stato dell'analisi della perizia.
///
/// Serve perché l'elaborazione è asincrona: la scheda esiste subito, la
/// sintesi arriva dopo. Senza uno stato esplicito l'agente non distingue "sto
/// ancora leggendo" da "non sono riuscito a leggere".
/// Fase della vendita giudiziaria.
///
/// Distinta da `archivedAt`, che riguarda la visibilita' in elenco e non la
/// pratica: un lotto andato DESERTA e' concluso come tentativo ma resta
/// interessante — si ripresenta a prezzo ribassato, ed e' il momento in cui
/// conviene guardarlo. Un solo campo per le due cose farebbe sparire dalla
/// vista proprio le occasioni migliori.
enum AuctionStatus {
  IN_ARRIVO
  ATTIVA
  DESERTA
  AGGIUDICATA
}

enum AppraisalStatus {
  IN_ANALISI
  PRONTA
  FALLITA
}

model RadarProperty {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  kind   RadarKind
  source RadarSource @default(MANUALE)
  /// Identificativo sul portale d'origine, quando esiste.
  sourceRef String?
  sourceUrl String?

  /// I cinque campi che `scorePropertyForLead` sa già leggere: tenerli con
  /// questi nomi permette di riusare il motore di matching senza adattatori.
  /// Indirizzo e civico dell'immobile, es. "Via Emilia 45".
  ///
  /// Facoltativo, ma e' cio' che sposta il pin dal centro del comune al
  /// portone: senza, tutti i lotti di Vignola finiscono sullo stesso punto e
  /// la mappa smette di essere utile proprio dove ci sono piu' occasioni.
  ///
  /// E' l'indirizzo dell'IMMOBILE, non la residenza dell'esecutato: il primo
  /// e' pubblicato nell'avviso di vendita, il secondo e' un dato personale che
  /// non entra in questo modulo.
  address      String?
  comune       String
  zona         String?
  type         PropertyType
  /// Offerta minima per un'asta, prezzo corrente per un ribasso.
  priceEur     Int
  squareMeters Int

  /// Valore di perizia, per il confronto con l'offerta minima.
  basePriceEur     Int?
  /// Prezzo precedente, da cui si calcola l'entità del ribasso.
  previousPriceEur Int?
  auctionDate      DateTime?

  /// Coordinate per la vista mappa. Facoltative: un lotto senza
  /// coordinate resta in elenco e semplicemente non compare fra i pin.
  /// Obbligarle bloccherebbe l'inserimento rapido di un'opportunita' vista
  /// di sfuggita, che e' il momento in cui la si registra davvero.
  latitude  Float?
  longitude Float?

  /// --- Parametri economici per il simulatore ---
  ///
  /// Vivono qui e non su `AuctionAppraisal` perche' non sono fatti letti nella
  /// perizia: sono ipotesi dell'agenzia su una specifica operazione, che due
  /// agenti possono valutare diversamente sullo stesso lotto. La perizia dice
  /// quanto costa sanare; quanto rivendere e a quanto affittare lo decide chi
  /// conosce il mercato di quella via.

  /// Imposte e spese di trasferimento stimate (registro, ipotecaria, catastale,
  /// compenso del delegato). `null` = non ancora stimate.
  transferCostsEur Int?
  /// Costo di ristrutturazione e sanatoria. Precompilato dalla stima della
  /// perizia, ma sovrascrivibile: il perito stima il minimo per sanare, non il
  /// costo di rimettere a nuovo per rivendere.
  renovationCostEur Int?
  /// Valore di mercato atteso a lavori conclusi.
  marketValueEur Int?
  /// Canone mensile atteso, per il calcolo del rendimento da locazione.
  monthlyRentEur Int?

  /// --- Rilevamento ribassi ---
  ///
  /// Scritti quando il prezzo viene aggiornato al ribasso. Servono al badge in
  /// scheda e all'avviso in dashboard, che si spegne quando l'agente lo ha
  /// visto: un avviso che resta acceso per sempre smette di essere un avviso.
  priceDropPct        Int?
  priceDropAt         DateTime?
  /// Quanti lead sono rientrati nel budget grazie al ribasso.
  priceDropNewMatches Int?
  priceDropSeenAt     DateTime?
  lotto            String?
  notes            String?

  /// Archiviato invece che cancellato: un'asta conclusa resta consultabile,
  /// e gli abbinamenti già mostrati all'agente non spariscono dalla storia.
  /// Etichette scelte dall'agente per ritrovare un lotto fra cento.
  ///
  /// Insieme chiuso, non testo libero: sono il criterio di un filtro, e con la
  /// scrittura libera nascono "reddito", "a reddito" e "Reddito" come tre
  /// categorie diverse che nessun filtro rimette insieme.
  ///
  /// Non contiene "Occupato" e "Libero": quel dato lo produce gia' la perizia
  /// in `AuctionAppraisal.occupancy`, e un'etichetta scritta a mano che lo
  /// contraddice lascerebbe l'agente davanti a due risposte senza sapere
  /// quale credere.
  tags String[] @default([])

  /// Fase della vendita. `null` finche' l'agente non la indica: dedurla dalla
  /// data d'asta sarebbe sbagliato, perche' una vendita puo' essere rinviata
  /// e il calendario non lo sa.
  auctionStatus AuctionStatus?

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appraisal AuctionAppraisal?
  matches   AuctionLeadMatch[]

  /// Reimportare la stessa fonte aggiorna invece di duplicare.
  @@unique([organizationId, source, sourceRef])
  @@index([organizationId, kind, auctionDate])
  @@index([organizationId, archivedAt])
}

/// Sintesi AI di una perizia giudiziaria.
///
/// # Cosa NON viene conservato
///
/// Il PDF della perizia non viene salvato: resta in memoria per la durata
/// dell'analisi e viene scartato. Una perizia contiene nome, situazione
/// patrimoniale e talvolta condizioni familiari del debitore esecutato —
/// persone che non sono clienti dell'agenzia e non hanno prestato alcun
/// consenso. Di quel documento serve il contenuto tecnico, non l'identità di
/// chi ha subito l'esecuzione, e il prompt ha istruzione esplicita di
/// escluderla. Chi vuole archiviare il PDF lo carica nel Fascicolo, dove la
/// conservazione è una scelta dichiarata.
model AuctionAppraisal {
  id String @id @default(cuid())

  radarPropertyId String        @unique
  radarProperty   RadarProperty @relation(fields: [radarPropertyId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  status        AppraisalStatus @default(IN_ANALISI)
  /// Messaggio comprensibile all'agente quando `status` è FALLITA.
  failureReason String?

  occupancy      OccupancyStatus @default(NON_DETERMINATO)
  risk           RiskLevel       @default(GIALLO)
  /// I criteri che hanno prodotto quel colore, in chiaro.
  riskReasons    String[]        @default([])
  irregularities String[]        @default([])
  encumbrances   String[]        @default([])

  remediationCostMinEur Int?
  remediationCostMaxEur Int?

  summary String?

  /// Quante pagine sono state effettivamente analizzate: con la selezione
  /// manuale può essere un sottoinsieme, e l'agente deve saperlo prima di
  /// fidarsi della sintesi.
  pagesAnalysed Int?
  pageRange     String?
  /// Modello usato, per poter ricostruire come è stato prodotto un esito.
  model         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
}

/// Abbinamento fra un'opportunità del Radar e un lead già in pipeline.
///
/// Distinto da `PropertyLeadMatch`, che riguarda il portafoglio dell'agenzia:
/// stesso motore di punteggio, oggetti diversi. Unirli significherebbe una
/// colonna nullable per lato e query che devono sempre ricordarsi quale dei
/// due sta guardando.
model AuctionLeadMatch {
  id String @id @default(cuid())

  radarPropertyId String
  radarProperty   RadarProperty @relation(fields: [radarPropertyId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  score   Int
  reasons String[] @default([])

  seenAt DateTime?
  /// Quando l'agente ha approvato l'invio del messaggio al cliente. `null`
  /// significa "mai inviato": non esiste invio automatico.
  notifiedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([radarPropertyId, leadId])
  @@index([organizationId, score])
}

/// Domanda degli acquirenti per zona, con coordinate.
///
/// # Perche' una tabella e non due colonne su `Lead`
///
/// La mappa di calore ha bisogno di coordinate, e `Lead.preferredZone` e' testo
/// libero. Geocodificare a ogni apertura della mappa significherebbe decine di
/// chiamate a un servizio gratuito per un dato che non cambia: le zone
/// distinte di un'agenzia sono poche e stabili, i lead che le indicano cambiano
/// di continuo.
///
/// Tenerla qui invece che su `Lead` mantiene il modulo isolato: il Radar legge
/// i lead, non li modifica, e disattivarlo non lascerebbe colonne orfane su una
/// tabella del nucleo.
model RadarZoneDemand {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Zona normalizzata (minuscola, senza spazi ai lati): e' la chiave con cui
  /// si raggruppano i `Lead.preferredZone` scritti in modo diverso.
  zoneKey String
  /// La forma leggibile, come l'ha scritta il primo lead che l'ha nominata.
  label   String

  /// `null` quando la geocodifica non ha trovato nulla: si registra comunque,
  /// per non riprovare a ogni apertura della mappa una ricerca gia' fallita.
  latitude  Float?
  longitude Float?

  resolvedAt DateTime @default(now())

  @@unique([organizationId, zoneKey])
  @@index([organizationId])
}
